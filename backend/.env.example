# backend/.env.example

# Server
PORT=3000

# Database
# PostgreSQL connection string format:
# postgresql://username:password@host:port/database
# get a free database at https://neon.tech
DATABASE_URL=your_database_url_here

# JWT
# JWT_SECRET should be a long, random string for security
# you can generate one using openssl or an online generator
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN="7d"

# Admin account credentials
# used by the createAdmin script to create the initial admin user
ADMIN_EMAIL=your_admin_email_here
ADMIN_PASSWORD=your_admin_password_here